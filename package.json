{
  "name": "queueforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A PostgreSQL-backed background job platform.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "worker": "tsx src/worker/index.ts",
    "start:worker": "node dist/worker/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/infrastructure/database/migrate.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript-eslint": "^8.43.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
